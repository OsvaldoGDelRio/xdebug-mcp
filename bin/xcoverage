#!/usr/bin/env php
<?php

// Load autoloader
require_once __DIR__ . '/autoload.php';
use Koriym\XdebugMcp\XdebugFinder;

// Xdebug's sentinel value for "exit" branch target in branch coverage data
const XDEBUG_BRANCH_EXIT_SENTINEL = 2147483645;

// Show help if requested
if (in_array('--help', $argv) || in_array('-h', $argv)) {
    echo "Usage: " . $argv[0] . " [OPTIONS] [--] [phpunit args | php vendor/bin/phpunit [args...]]\n";
    echo "\n";
    echo "AI-Optimized PHP Code Coverage Collection Tool\n";
    echo "\n";
    echo "PURPOSE:\n";
    echo "  Superior alternative to PHPUnit's HTML/XML coverage reports for AI analysis.\n";
    echo "  Provides streamlined JSON coverage data that AI can immediately analyze\n";
    echo "  without browser interaction or file navigation overhead.\n";
    echo "\n";
    echo "MODES:\n";
    echo "  Default (PHPUnit mode):\n";
    echo "    Uses PHPUnit's --coverage-clover for coverage collection.\n";
    echo "    Respects @codeCoverageIgnore annotations and phpunit.xml settings.\n";
    echo "\n";
    echo "  --raw mode:\n";
    echo "    Uses Xdebug directly for raw coverage data.\n";
    echo "    Ignores PHPUnit annotations. Works with any PHP script.\n";
    echo "\n";
    echo "OPTIONS:\n";
    echo "  --raw                     Use raw Xdebug coverage (ignores @codeCoverageIgnore)\n";
    echo "  --branch-coverage         Enable branch/path coverage (--raw mode only)\n";
    echo "  --include-vendor=PATTERNS Include vendor packages (--raw mode only)\n";
    echo "  --cwd=PATH                Run the target command from this working directory\n";
    echo "  --php-binary=PATH         PHP binary used to run PHPUnit or raw scripts\n";
    echo "  --env=KEY=VALUE           Environment variable for the target command (repeatable)\n";
    echo "  --source=PATHS            Comma-separated source paths to include in JSON output\n";
    echo "  --exclude=PATHS           Comma-separated paths to exclude from JSON output\n";
    echo "  --help, -h                Show this help\n";
    echo "\n";
    echo "COMMON USAGE PATTERNS:\n";
    echo "  # Default: PHPUnit mode with @codeCoverageIgnore support\n";
    echo "  " . $argv[0] . "\n";
    echo "  " . $argv[0] . " -- php ./vendor/bin/phpunit --filter MyTest\n";
    echo "\n";
    echo "  # Raw mode: Xdebug direct coverage (any PHP script)\n";
    echo "  " . $argv[0] . " --raw -- php app.php\n";
    echo "\n";
    echo "  # Include specific vendor packages (raw mode)\n";
    echo "  " . $argv[0] . " --raw --include-vendor=bear/resource,ray/di -- php script.php\n";
    echo "\n";
    echo "OUTPUT FORMAT:\n";
    echo "  - summary: {files, total_lines, covered_lines, uncovered_lines, coverage_percent}\n";
    echo "  - uncovered: Ranges of uncovered lines, e.g., [10, \"15-20\", 25]\n";
    echo "  Schema: https://koriym.github.io/xdebug-mcp/schemas/xcoverage.json\n";
    echo "\n";
    exit(0);
}

// Parse options
$optind = 0;
$options = getopt('', ['include-vendor::', 'branch-coverage', 'raw', 'cwd:', 'php-binary:', 'env:', 'source:', 'exclude:'], $optind);

$includeVendor = $options['include-vendor'] ?? null;
$branchCoverage = isset($options['branch-coverage']);
$rawMode = isset($options['raw']);
$cwd = isset($options['cwd']) ? (string) $options['cwd'] : null;
$phpBinaryOption = isset($options['php-binary']) ? (string) $options['php-binary'] : null;

// Get remaining arguments
$args = $optind !== null ? array_slice($argv, $optind) : [];

// Remove the option delimiter if present
if (!empty($args) && $args[0] === '--') {
    $args = array_slice($args, 1);
}

// Debug mode
$debug = getenv('COVERAGE_DEBUG');
if ($debug) {
    fwrite(STDERR, "[COVERAGE_DEBUG] Raw mode: " . ($rawMode ? 'true' : 'false') . "\n");
    fwrite(STDERR, "[COVERAGE_DEBUG] Args: " . json_encode($args) . "\n");
}

applyEnvironmentOption($options['env'] ?? []);

if ($cwd !== null && $cwd !== '') {
    $resolvedCwd = realpath($cwd);
    if ($resolvedCwd === false || ! is_dir($resolvedCwd)) {
        fwrite(STDERR, "Error: cwd not found: {$cwd}\n");
        exit(1);
    }

    chdir($resolvedCwd);
}

$argumentPhpBinary = extractPhpBinaryFromArguments($args);
$phpBinary = $phpBinaryOption !== null && $phpBinaryOption !== ''
    ? $phpBinaryOption
    : ($argumentPhpBinary ?? PHP_BINARY);

$sourceFilters = parsePathFilters($options['source'] ?? []);
$excludeFilters = parsePathFilters($options['exclude'] ?? []);

/**
 * @param string|array<int, string> $envOption
 */
function applyEnvironmentOption(string|array $envOption): void
{
    $entries = is_array($envOption) ? $envOption : [$envOption];
    foreach ($entries as $entry) {
        if ($entry === '') {
            continue;
        }

        if (! str_contains($entry, '=')) {
            fwrite(STDERR, "Error: --env must use KEY=VALUE format: {$entry}\n");
            exit(1);
        }

        putenv($entry);
    }
}

/**
 * @param list<string> $args
 */
function extractPhpBinaryFromArguments(array &$args): string|null
{
    if ($args === [] || ! isPhpBinary($args[0])) {
        return null;
    }

    return array_shift($args);
}

/**
 * Normalize a user-provided PHPUnit command into arguments for the local PHPUnit binary.
 *
 * xcoverage asks PHPUnit for Clover output, so flags that disable coverage are removed.
 *
 * @param list<string> $args
 *
 * @return list<string>
 */
function normalizePhpUnitArguments(array $args): array
{
    if (! empty($args) && isPhpBinary($args[0])) {
        $args = array_slice($args, 1);
    }

    if (! empty($args) && isPhpUnitCommand($args[0])) {
        $args = array_slice($args, 1);
    }

    $normalized = [];
    foreach ($args as $arg) {
        if ($arg === '--no-coverage') {
            continue;
        }

        $normalized[] = $arg;
    }

    return $normalized;
}

/**
 * @param list<string> $args
 *
 * @return list<string>
 */
function normalizeRawArguments(array $args): array
{
    return $args;
}

function isPhpBinary(string $arg): bool
{
    $binary = basename(str_replace('\\', '/', $arg));

    return preg_match('/^php(?:[0-9.]+)?(?:\.exe)?$/i', $binary) === 1;
}

function isPhpUnitCommand(string $arg): bool
{
    $binary = basename(str_replace('\\', '/', $arg));

    return $binary === 'phpunit' || $binary === 'phpunit.phar';
}

/**
 * @param string|array<int, string> $option
 *
 * @return list<string>
 */
function parsePathFilters(string|array $option): array
{
    $values = is_array($option) ? $option : [$option];
    $filters = [];
    foreach ($values as $value) {
        foreach (explode(',', $value) as $path) {
            $path = trim($path);
            if ($path === '') {
                continue;
            }

            $filters[] = normalizeCoveragePath($path);
        }
    }

    return array_values(array_unique($filters));
}

function normalizeCoveragePath(string $path): string
{
    if (! isAbsoluteCoveragePath($path) && ! str_contains($path, '*')) {
        $path = getcwd() . DIRECTORY_SEPARATOR . $path;
    }

    $realPath = str_contains($path, '*') ? false : realpath($path);
    $normalized = str_replace('\\', '/', $realPath !== false ? $realPath : $path);

    return rtrim($normalized, '/');
}

function isAbsoluteCoveragePath(string $path): bool
{
    return str_starts_with($path, '/') || preg_match('/^[A-Za-z]:[\\\\\\/]/', $path) === 1;
}

/**
 * @param list<string> $phpunitArgs
 *
 * @return list<string>
 */
function extractPhpUnitCoverageFilters(array $phpunitArgs): array
{
    $filters = [];
    for ($i = 0; $i < count($phpunitArgs); $i++) {
        $arg = $phpunitArgs[$i];
        if ($arg === '--coverage-filter' && isset($phpunitArgs[$i + 1])) {
            $filters[] = $phpunitArgs[$i + 1];
            $i++;
            continue;
        }

        if (str_starts_with($arg, '--coverage-filter=')) {
            $filters[] = substr($arg, strlen('--coverage-filter='));
        }
    }

    return parsePathFilters($filters);
}

/**
 * @param list<string> $sourceFilters
 * @param list<string> $excludeFilters
 */
function shouldIncludeCoverageFile(string $filePath, array $sourceFilters, array $excludeFilters): bool
{
    $normalizedFile = normalizeCoveragePath($filePath);

    if ($sourceFilters !== [] && ! coveragePathMatchesAnyFilter($normalizedFile, $sourceFilters)) {
        return false;
    }

    return ! coveragePathMatchesAnyFilter($normalizedFile, $excludeFilters);
}

/**
 * @param list<string> $filters
 */
function coveragePathMatchesAnyFilter(string $normalizedFile, array $filters): bool
{
    foreach ($filters as $filter) {
        if (str_contains($filter, '*') && fnmatch($filter, $normalizedFile)) {
            return true;
        }

        if ($normalizedFile === $filter || str_starts_with($normalizedFile, $filter . '/')) {
            return true;
        }
    }

    return false;
}

function isIgnorableCoverageLine(string $filePath, int $lineNum): bool
{
    static $lineCache = [];

    $normalizedFile = normalizeCoveragePath($filePath);
    if (! array_key_exists($normalizedFile, $lineCache)) {
        $lineCache[$normalizedFile] = is_file($normalizedFile) ? file($normalizedFile) : false;
    }

    if ($lineCache[$normalizedFile] === false || ! isset($lineCache[$normalizedFile][$lineNum - 1])) {
        return false;
    }

    $line = trim($lineCache[$normalizedFile][$lineNum - 1]);

    return $line === '' || preg_match('/^[{}\\[\\](),;]+$/', $line) === 1;
}

/**
 * @param list<int> $lineNums
 *
 * @return list<int|string>
 */
function groupLineRanges(array $lineNums): array
{
    if ($lineNums === []) {
        return [];
    }

    sort($lineNums);
    $ranges = [];
    $start = $lineNums[0];
    $end = $start;

    for ($i = 1; $i < count($lineNums); $i++) {
        if ($lineNums[$i] === $end + 1) {
            $end = $lineNums[$i];
            continue;
        }

        $ranges[] = ($start === $end) ? $start : "{$start}-{$end}";
        $start = $lineNums[$i];
        $end = $start;
    }

    $ranges[] = ($start === $end) ? $start : "{$start}-{$end}";

    return $ranges;
}

// PHPUnit mode (default) - uses PHPUnit's coverage with @codeCoverageIgnore support
if (!$rawMode) {
    // Check if PHPUnit is available
    if (!file_exists('./vendor/bin/phpunit')) {
        fwrite(STDERR, "Error: PHPUnit not found. Use --raw mode for non-PHPUnit projects.\n");
        fwrite(STDERR, "Example: " . $argv[0] . " --raw -- php script.php\n");
        exit(1);
    }

    // Create temp file for coverage data (clover XML format for stability)
    $coverageFile = tempnam(sys_get_temp_dir(), 'phpunit_coverage_') . '.xml';

    // Get Xdebug flag for explicit loading
    $phpPath = $phpBinary;
    $xdebugFlag = XdebugFinder::getXdebugFlagForPhpBinary($phpPath);

    // Build PHPUnit command with coverage-clover (stable XML format)
    $phpunitArgs = array_merge(
        ['--coverage-clover=' . $coverageFile, '--testdox', '--no-progress', '--colors=never'],
        normalizePhpUnitArguments($args),
    );
    if ($sourceFilters === []) {
        $sourceFilters = extractPhpUnitCoverageFilters($phpunitArgs);
    }

    echo "# Running PHPUnit with coverage (respects @codeCoverageIgnore)\n";

    $escapedArgs = array_map('escapeshellarg', $phpunitArgs);
    // Run PHPUnit via PHP with Xdebug enabled
    $cmd = escapeshellarg($phpPath) . $xdebugFlag . ' -dxdebug.mode=coverage -dpcov.enabled=0 ' . escapeshellarg('./vendor/bin/phpunit') . ' ' . implode(' ', $escapedArgs);

    if ($debug) {
        fwrite(STDERR, "[COVERAGE_DEBUG] PHPUnit command: $cmd\n");
    }

    // Run PHPUnit and capture output
    $lines = [];
    $exitCode = 0;
    exec($cmd . ' 2>&1', $lines, $exitCode);
    $testOutput = implode("\n", $lines);

    // Output test results
    echo $testOutput . "\n";

    // Check if coverage file was created
    if (!file_exists($coverageFile)) {
        fwrite(STDERR, "\nWarning: Coverage file was not created. Tests may have failed.\n");
        exit($exitCode);
    }

    // Load and process clover XML coverage data
    try {
        libxml_use_internal_errors(true);
        $xml = simplexml_load_file($coverageFile);
        if ($xml === false) {
            $errors = libxml_get_errors();
            $errorMsg = !empty($errors) ? $errors[0]->message : 'Unknown XML parsing error';
            libxml_clear_errors();
            throw new RuntimeException('Failed to parse clover XML: ' . trim($errorMsg));
        }

        // Convert clover XML to xcoverage format
        $uncoveredOnly = [];
        $totalFiles = 0;
        $totalLines = 0;
        $coveredLines = 0;
        $uncoveredLines = 0;

        // Handle empty coverage (no files)
        if (!isset($xml->project->file)) {
            $result = [
                '$schema' => 'https://koriym.github.io/xdebug-mcp/schemas/xcoverage.json',
                'coverage_type' => 'line',
                'mode' => 'phpunit',
                'summary' => [
                    'files' => 0,
                    'total_lines' => 0,
                    'covered_lines' => 0,
                    'uncovered_lines' => 0,
                    'coverage_percent' => 0
                ],
                'uncovered' => []
            ];
            echo json_encode($result, JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT) . "\n";
            unlink($coverageFile);
            exit($exitCode);
        }

        foreach ($xml->project->file as $file) {
            $filePath = (string)$file['name'];
            if (! shouldIncludeCoverageFile($filePath, $sourceFilters, $excludeFilters)) {
                continue;
            }

            $totalFiles++;
            $uncoveredLineNums = [];

            foreach ($file->line as $line) {
                // Only process statement lines (skip method declarations)
                if ((string)$line['type'] !== 'stmt') {
                    continue;
                }

                $lineNum = (int)$line['num'];
                if (isIgnorableCoverageLine($filePath, $lineNum)) {
                    continue;
                }

                $count = (int)$line['count'];
                $totalLines++;

                if ($count > 0) {
                    $coveredLines++;
                } else {
                    $uncoveredLines++;
                    $uncoveredLineNums[] = $lineNum;
                }
            }

            if (!empty($uncoveredLineNums)) {
                $uncoveredOnly[$filePath] = groupLineRanges($uncoveredLineNums);
            }
        }

        $coveragePercent = $totalLines > 0 ? round(($coveredLines / $totalLines) * 100, 1) : 0;

        $result = [
            '$schema' => 'https://koriym.github.io/xdebug-mcp/schemas/xcoverage.json',
            'coverage_type' => 'line',
            'mode' => 'phpunit',
            'summary' => [
                'files' => $totalFiles,
                'total_lines' => $totalLines,
                'covered_lines' => $coveredLines,
                'uncovered_lines' => $uncoveredLines,
                'coverage_percent' => $coveragePercent
            ],
            'uncovered' => $uncoveredOnly
        ];

        echo json_encode($result, JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT) . "\n";

    } catch (Throwable $e) {
        fwrite(STDERR, "Error processing coverage: " . $e->getMessage() . "\n");
        exit(1);
    } finally {
        // Cleanup
        if (file_exists($coverageFile)) {
            unlink($coverageFile);
        }
    }

    exit($exitCode);
}

// Raw mode - uses Xdebug directly (original behavior)
$args = normalizeRawArguments($args);
$shutdownScript = tempnam(sys_get_temp_dir(), 'coverage_end_');
$branchFlag = $branchCoverage ? 'true' : 'false';
$exportedSourceFilters = var_export($sourceFilters, true);
$exportedExcludeFilters = var_export($excludeFilters, true);
$includeVendorRequire = '';
if ($includeVendor !== null) {
    $filterPath = __DIR__ . '/../prepend_filter.php';
    $includeVendorRequire = 'require_once ' . var_export($filterPath, true) . ';';
    putenv('COVERAGE_INCLUDE_VENDOR=' . $includeVendor);
}

file_put_contents($shutdownScript, '<?php
' . $includeVendorRequire . '
$tempDir = sys_get_temp_dir();
$branchCoverage = ' . $branchFlag . ';
$sourceFilters = ' . $exportedSourceFilters . ';
$excludeFilters = ' . $exportedExcludeFilters . ';
function xdebug_mcp_normalize_coverage_path(string $path): string {
    $realPath = strpos($path, "*") === false ? realpath($path) : false;
    return rtrim(str_replace("\\\\", "/", $realPath !== false ? $realPath : $path), "/");
}
function xdebug_mcp_path_matches_any_filter(string $normalizedFile, array $filters): bool {
    foreach ($filters as $filter) {
        if (strpos($filter, "*") !== false && fnmatch($filter, $normalizedFile)) {
            return true;
        }
        if ($normalizedFile === $filter || str_starts_with($normalizedFile, $filter . "/")) {
            return true;
        }
    }
    return false;
}
function xdebug_mcp_should_include_coverage_file(string $filePath, array $sourceFilters, array $excludeFilters): bool {
    $normalizedFile = xdebug_mcp_normalize_coverage_path($filePath);
    if ($sourceFilters !== [] && ! xdebug_mcp_path_matches_any_filter($normalizedFile, $sourceFilters)) {
        return false;
    }
    return ! xdebug_mcp_path_matches_any_filter($normalizedFile, $excludeFilters);
}
function xdebug_mcp_is_ignorable_coverage_line(string $filePath, int $lineNum): bool {
    static $lineCache = [];
    $normalizedFile = xdebug_mcp_normalize_coverage_path($filePath);
    if (! array_key_exists($normalizedFile, $lineCache)) {
        $lineCache[$normalizedFile] = is_file($normalizedFile) ? file($normalizedFile) : false;
    }
    if ($lineCache[$normalizedFile] === false || ! isset($lineCache[$normalizedFile][$lineNum - 1])) {
        return false;
    }
    $line = trim($lineCache[$normalizedFile][$lineNum - 1]);
    return $line === "" || preg_match("/^[{}\\\\[\\\\](),;]+$/", $line) === 1;
}
function xdebug_mcp_group_line_ranges(array $lineNums): array {
    if ($lineNums === []) {
        return [];
    }
    sort($lineNums);
    $ranges = [];
    $start = $lineNums[0];
    $end = $start;
    for ($i = 1; $i < count($lineNums); $i++) {
        if ($lineNums[$i] === $end + 1) {
            $end = $lineNums[$i];
            continue;
        }
        $ranges[] = ($start === $end) ? $start : "$start-$end";
        $start = $lineNums[$i];
        $end = $start;
    }
    $ranges[] = ($start === $end) ? $start : "$start-$end";
    return $ranges;
}
if ($branchCoverage) {
    if ($sourceFilters !== []) {
        xdebug_set_filter(XDEBUG_FILTER_CODE_COVERAGE, XDEBUG_PATH_INCLUDE, $sourceFilters);
    } else {
        xdebug_set_filter(XDEBUG_FILTER_CODE_COVERAGE, XDEBUG_PATH_EXCLUDE, [getcwd() . "/vendor/", $tempDir]);
    }
    xdebug_start_code_coverage(XDEBUG_CC_UNUSED | XDEBUG_CC_DEAD_CODE | XDEBUG_CC_BRANCH_CHECK);
} else {
    if ($sourceFilters !== []) {
        xdebug_set_filter(XDEBUG_FILTER_CODE_COVERAGE, XDEBUG_PATH_INCLUDE, $sourceFilters);
    } else {
        xdebug_set_filter(XDEBUG_FILTER_CODE_COVERAGE, XDEBUG_PATH_EXCLUDE, [getcwd() . "/vendor/", getcwd() . "/tests/", $tempDir]);
    }
    xdebug_start_code_coverage(XDEBUG_CC_UNUSED | XDEBUG_CC_DEAD_CODE);
}
register_shutdown_function(function() use ($tempDir, $branchCoverage, $sourceFilters, $excludeFilters) {
    $coverage = xdebug_get_code_coverage();
    $filtered = array_filter($coverage, function($path) use ($tempDir, $sourceFilters, $excludeFilters) {
        return strpos($path, $tempDir) === false
            && xdebug_mcp_should_include_coverage_file($path, $sourceFilters, $excludeFilters);
    }, ARRAY_FILTER_USE_KEY);

    if ($branchCoverage) {
        $dotFilePath = tempnam(sys_get_temp_dir(), "xdebug_branch_coverage_") . ".dot";
        $dotContent = "digraph coverage {\n  rankdir=TB;\n  node [shape=box];\n\n";

        foreach ($filtered as $file => $data) {
            if (isset($data["functions"])) {
                foreach ($data["functions"] as $function => $funcData) {
                    if (isset($funcData["branches"])) {
                        $dotContent .= "  // Function: $function\n";
                        foreach ($funcData["branches"] as $branchId => $branch) {
                            $label = "Branch $branchId\\nLines {$branch["line_start"]}-{$branch["line_end"]}";
                            $style = $branch["hit"] > 0 ? "filled,solid" : "filled,dashed";
                            $color = $branch["hit"] > 0 ? "lightgreen" : "lightcoral";
                            $dotContent .= "  \"$function-$branchId\" [label=\"$label\", style=\"$style\", fillcolor=\"$color\"];\n";

                            foreach ($branch["out"] as $i => $targetBranch) {
                                if ($targetBranch !== ' . XDEBUG_BRANCH_EXIT_SENTINEL . ') {
                                    $edgeStyle = ($branch["out_hit"][$i] ?? 0) > 0 ? "solid" : "dashed";
                                    $dotContent .= "  \"$function-$branchId\" -> \"$function-$targetBranch\" [style=\"$edgeStyle\"];\n";
                                }
                            }
                        }
                        $dotContent .= "\n";
                    }
                }
            }
        }

        $dotContent .= "}\n";
        file_put_contents($dotFilePath, $dotContent);
        $outputPath = pathinfo($dotFilePath, PATHINFO_DIRNAME) . "/" . pathinfo($dotFilePath, PATHINFO_FILENAME) . ".png";

        $result = [
            "\$schema" => "https://koriym.github.io/xdebug-mcp/schemas/xcoverage-branch.json",
            "coverage_type" => "branch",
            "mode" => "raw",
            "coverage" => $filtered,
            "graphviz_dot_file" => $dotFilePath,
            "visualization_command" => "dot -Tpng " . escapeshellarg($dotFilePath) . " -o " . escapeshellarg($outputPath)
        ];
    } else {
        $uncoveredOnly = [];
        $totalFiles = 0;
        $totalLines = 0;
        $coveredLines = 0;
        $uncoveredLines = 0;

        foreach ($filtered as $file => $lines) {
            if (is_array($lines)) {
                $totalFiles++;
                $uncoveredLineNums = [];
                foreach ($lines as $lineNum => $hitCount) {
                    if (is_numeric($lineNum)) {
                        if (xdebug_mcp_is_ignorable_coverage_line($file, (int)$lineNum)) {
                            continue;
                        }

                        $totalLines++;
                        if ($hitCount > 0) {
                            $coveredLines++;
                        } else {
                            $uncoveredLines++;
                            $uncoveredLineNums[] = (int)$lineNum;
                        }
                    }
                }
                if (!empty($uncoveredLineNums)) {
                    $uncoveredOnly[$file] = xdebug_mcp_group_line_ranges($uncoveredLineNums);
                }
            }
        }

        $coveragePercent = $totalLines > 0 ? round(($coveredLines / $totalLines) * 100, 1) : 0;

        $result = [
            "\$schema" => "https://koriym.github.io/xdebug-mcp/schemas/xcoverage.json",
            "coverage_type" => "line",
            "mode" => "raw",
            "summary" => [
                "files" => $totalFiles,
                "total_lines" => $totalLines,
                "covered_lines" => $coveredLines,
                "uncovered_lines" => $uncoveredLines,
                "coverage_percent" => $coveragePercent
            ],
            "uncovered" => $uncoveredOnly
        ];
    }
    echo(json_encode($result, JSON_UNESCAPED_SLASHES));
});
');

$phpPath = $phpBinary;
$xdebugFlag = XdebugFinder::getXdebugFlagForPhpBinary($phpPath);
$escapedPrependFile = escapeshellarg($shutdownScript);

// Default to PHPUnit for raw mode if no args
if (empty($args)) {
    if (file_exists('./vendor/bin/phpunit')) {
        $args = ['./vendor/bin/phpunit', '--no-coverage', '--testdox', '--no-progress', '--colors=never'];
        echo "# Raw mode: Running PHPUnit with Xdebug direct coverage\n";
    } else {
        echo "Usage: " . $argv[0] . " --raw [--branch-coverage] [--include-vendor=PATTERNS] [--] php script.php [args...]\n";
        echo "No arguments provided and ./vendor/bin/phpunit not found.\n";
        exit(1);
    }
}

$escapedArgs = array_map('escapeshellarg', $args);
$cmd = escapeshellarg($phpPath)
     . $xdebugFlag
     . ' -dxdebug.mode=coverage -dauto_prepend_file='
     . $escapedPrependFile
     . ' '
     . implode(' ', $escapedArgs);

if ($debug) {
    fwrite(STDERR, "[COVERAGE_DEBUG] Command: $cmd\n");
}

$lines = [];
$exitCode = 0;
exec($cmd . ' 2>&1', $lines, $exitCode);
$output = implode("\n", $lines);

echo $output;
unlink($shutdownScript);
exit($exitCode);
